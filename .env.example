APP_NAME="Store Intelligence"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=platform
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Shopify app (values live in Railway variables, never in the repo)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_SCOPES=read_products,read_inventory,read_locations,read_orders
# Managed Pricing: app handle from admin.shopify.com/store/{shop}/apps/{handle}
SHOPIFY_APP_HANDLE=store-intelligence-app
# Plan display names as configured in the Partner Dashboard (defaults shown)
SHOPIFY_PLAN_NAME_FREE=Free
SHOPIFY_PLAN_NAME_STARTER=Starter
SHOPIFY_PLAN_NAME_GROWTH=Growth
SHOPIFY_PLAN_NAME_PRO=Pro
# Our own dev stores with plan access and no subscription (comma-separated)
SI_TEST_SHOPS=
SI_TEST_SHOP_PLAN=pro
SHOPIFY_INSTALL_URL=

# First super admin, created on deploy only when no admin exists yet
SI_ADMIN_EMAIL=
SI_ADMIN_PASSWORD=

# The web container also runs the queue worker and scheduler (set false when a worker service runs them)
RUN_WORKERS=true
